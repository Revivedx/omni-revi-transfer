{
  "name": "omni-revi-transfer",
  "version": "0.0.9b",
  "description": "Browse, manage, and share your Steam Deck's native screenshots (gallery, storage limit, local QR sharing) from the Decky Quick Access Menu.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:personal": "npm run build && node scripts/package.mjs --personal",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Revivedx/omni-revi-transfer.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck",
    "screenshots",
    "qr-share"
  ],
  "author": "Revivedx",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/Revivedx/omni-revi-transfer/issues"
  },
  "homepage": "https://github.com/Revivedx/omni-revi-transfer#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "archiver": "^8.0.0",
    "node-ssh": "^13.2.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "qrcode-generator": "^2.0.4",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
